<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Test your knowledge from your study notes"
            android:textColor="#666666"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/quizNotesEditText"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Paste or type your study notes here..."
            android:inputType="textMultiLine"
            android:padding="15dp"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Number of questions"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/quizCountSpinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnGenerateQuiz"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="📝  Generate Quiz"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>