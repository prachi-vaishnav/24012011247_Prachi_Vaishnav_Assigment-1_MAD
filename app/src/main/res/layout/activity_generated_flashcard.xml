<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Your Flashcards"
                android:textColor="@color/text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Progress -->
        <TextView
            android:id="@+id/flashcardProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="52dp"
            android:layout_marginTop="2dp"
            android:text="Card 1 of 5"
            android:textColor="@color/primary_light"
            android:textSize="14sp" />

        <!-- Question Card -->
        <TextView
            android:id="@+id/flashcardQuestion"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_focus_card"
            android:gravity="center"
            android:padding="24dp"
            android:text="What is the main concept?"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Show Answer -->
        <Button
            android:id="@+id/btnShowAnswer"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="Show Answer"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Answer Card -->
        <TextView
            android:id="@+id/flashcardAnswer"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="22dp"
            android:text="The answer will appear here."
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:visibility="gone" />

        <!-- Previous -->
        <Button
            android:id="@+id/btnPreviousCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/surface_variant"
            android:text="‹  Previous Card"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Next -->
        <Button
            android:id="@+id/btnNextCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/primary"
            android:text="Next Card  ›"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>